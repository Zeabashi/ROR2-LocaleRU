    "BAZAAR_SEER_IRONALLUVIUM": "<style=cWorldEvent>Вы мечтаете о притягивающих силах.</style>",
    "BAZAAR_SEER_IRONALLUVIUM2": "<style=cWorldEvent>Вы мечтаете об отталкивающих силах.</style>",
    "BAZAAR_SEER_MOON": "<style=cWorldEvent>Вы мечтаете о стекле и грязи.</style>",
    "BAZAAR_SEER_NEST": "<style=cWorldEvent>Вы мечтаете о морозе и металле.</style>",
    "BAZAAR_SEER_REPURPOSEDCRATER": "<style=cWorldEvent>Вы мечтаете об оазисе.</style>",
