    "PROV_DIALOGUE_FORMAT": "<color=#ffc7c7><size=120%>Echo of Providence: {0}</color></size>",
    "PROV_DIALOGUE_PHASE1_SPAWN_01": "Cold... So cold...",
    "PROV_DIALOGUE_PHASE1_SPAWN_02": "Clouded vision... Terrible presence...",
    "PROV_DIALOGUE_PHASE1_RECOGNIZE_CROCO": "That odor...",
    "PROV_DIALOGUE_PHASE1_RECOGNIZE_FALSESON": "Brother...? Not quite...",
    "PROV_DIALOGUE_PHASE1_RECOGNIZE_HERETIC": "That cape... Familiar...",
    "PROV_DIALOGUE_PHASE1_HURT_01": "Slow...",
    "PROV_DIALOGUE_PHASE1_HURT_02": "Sloppy...",
    "PROV_DIALOGUE_PHASE1_HURT_03": "Predictable...",
    "PROV_DIALOGUE_PHASE1_HURT_04": "Naive...",
    "PROV_DIALOGUE_PHASE1_KILL_01": "From dust to dust...",
    "PROV_DIALOGUE_PHASE1_KILL_02": "Become memories...",
    "PROV_DIALOGUE_PHASE1_KILL_03": "Fall...",
    "PROV_DIALOGUE_PHASE1_DEATH_01": "This seems... Familiar...",
    "PROV_DIALOGUE_PHASE1_DEATH_02": "Almost... It's coming back to me...'",
    "PROV_DIALOGUE_DESPERATION_SPAWN_01": "My vision grows clear!",
    "PROV_DIALOGUE_DESPERATION_SPAWN_02": "At last, I understand!",
    "PROV_DIALOGUE_DESPERATION_SEE_CROCO": "That foul, acidic odor... You were on the ship.",
    "PROV_DIALOGUE_DESPERATION_SEE_HERETIC": "You dare face me again? You court death, Heretic.",
    "PROV_DIALOGUE_DESPERATION_SEE_FALSESON": "The power of the Colossus... twisted by that unmistakeable hatred. I will end your suffering.",
    "PROV_DIALOGUE_DESPERATION_SEE_HERETICANDFALSESON": "The Heretic and the corrupted power of the Colossus? Your schemes never cease to amaze me, Brother.",
    "PROV_DIALOGUE_DESPERATION_UNDEADARMY_01": "You walk among the dead, mortal.",
    "PROV_DIALOGUE_DESPERATION_UNDEADARMY_02": "One foot in the grave...",
    "PROV_DIALOGUE_DESPERATION_HURT_01": "Slow.",
    "PROV_DIALOGUE_DESPERATION_HURT_02": "Sloppy.",
    "PROV_DIALOGUE_DESPERATION_HURT_03": "An opening!",
    "PROV_DIALOGUE_DESPERATION_HURT_04": "How naive!",
    "PROV_DIALOGUE_DESPERATION_HURT_05": "Predictable.",
    "PROV_DIALOGUE_DESPERATION_KILL_01": "Poorly chosen.",
    "PROV_DIALOGUE_DESPERATION_KILL_02": "Disappointing.",
    "PROV_DIALOGUE_DESPERATION_KILL_03": "From dust to dust.",
    "PROV_DIALOGUE_DESPERATION_KILL_04": "Become memories.",
    "PROV_DIALOGUE_DESPERATION_KILL_05": "Die.",
    "PROV_DIALOGUE_DESPERATION_KILL_06": "Arrogant.",
    "PROV_DIALOGUE_DESPERATION_KILL_07": "Fall.",
    "PROV_DIALOGUE_DESPERATION_KILL_COMPLIMENT_01": "Well fought, stand proud.",
    "PROV_DIALOGUE_DESPERATION_KILL_COMPLIMENT_02": "A worthy opponent.",
    "PROV_DIALOGUE_DESPERATION_KILL_FALSESON_01": "Have a taste of divinity.",
    "PROV_DIALOGUE_DESPERATION_KILL_FALSESON_02": "Nothing but a false promise.",
    "PROV_DIALOGUE_DESPERATION_KILL_HERETIC_01": "Fall by my blade again, Heretic.",
    "PROV_DIALOGUE_DESPERATION_KILL_CROCO_01": "You will find no refuge here, monster.",
    "PROV_DIALOGUE_DESPERATION_KILL_MECHANICAL_01": "Disappointing construct. Dismantled.",
    "PROV_DIALOGUE_DESPERATION_KILL_MECHANICAL_02": "Needs more soul. Dismantled.",
    "PROV_DIALOGUE_DESPERATION_KILL_MECHANICAL_03": "Boring design. Dismantled.",
    "PROV_DIALOGUE_DESPERATION_DEATH_01": "You... monster...",
    "PROV_DIALOGUE_DESPERATION_DEATH_02": "What... are you...",
    "PROV_DIALOGUE_DESPERATION_DEATH_03": "How...?",
    "PROV_DIALOGUE_FINAL_SPAWN_01": "You thought me defeated...?!",
    "PROV_DIALOGUE_FINAL_SEE_TITANGOLD_01": "The Guardian... Why now...?!",
    "PROV_DIALOGUE_FINAL_KILL_TITANGOLD_01": "Forgive me... Guardian...",
    "PROV_DIALOGUE_FINAL_KILL_TITANGOLD_02": "You never deserved this... Guardian...",
    "PROV_DIALOGUE_FINAL_WARNING1_01": "Give me... Your soul...!",
    "PROV_DIALOGUE_FINAL_WARNING2_01": "My time grows short... Before I fade away... I must...",
    "PROV_DIALOGUE_FINAL_WARNING3_01": "Brother...!",
    "PROV_DIALOGUE_FINAL_DEATH_01": "It is... No longer cold...",
    "PROV_DIALOGUE_FINAL_DEATH_02": "Finally... peace...",
    "PROV_DIALOGUE_FINAL_DEATH_03": "Warm... It feels... warm...",
    "PROV_DIALOGUE_FINAL_DEATH_04": "Brother... Are you there...?",
