    "BAZAAR_SEER_ANCIENTLOFT": "<style=cWorldEvent>You dream of clarity.</style>",
    "BAZAAR_SEER_CONDUITCANYON": "<style=cWorldEvent>You dream of flowing power.</style>",
    "BAZAAR_SEER_DAMPCAVESIMPLE": "<style=cWorldEvent>You dream of fire.</style>",
    "BAZAAR_SEER_GOLDSHORES": "<style=cWorldEvent>You dream of wealth.</style>",
    "BAZAAR_SEER_IRONALLUVIUM": "<style=cWorldEvent>You dream of attracting forces.</style>",
    "BAZAAR_SEER_IRONALLUVIUM2": "<style=cWorldEvent>You dream of repelling forces.</style>",
    "BAZAAR_SEER_MOON": "<style=cWorldEvent>You dream of glass and dirt.</style>",
    "BAZAAR_SEER_NEST": "<style=cWorldEvent>You dream of frost and metal.</style>",
    "BAZAAR_SEER_REPURPOSEDCRATER": "<style=cWorldEvent>You dream of an oasis.</style>",
    "BAZAAR_SEER_ROOTJUNGLE": "<style=cWorldEvent>You dream of violent growth.</style>",
    "BAZAAR_SEER_SHIPGRAVEYARD": "<style=cWorldEvent>You dream of wind.</style>",
    "BAZAAR_SEER_SKYMEADOW": "<style=cWorldEvent>You dream of serenity.</style>",
