    "UNLOCKABLE_LOG_STAGES_CONDUITCANYON": "Environment Log: Conduit Canyon",
    "UNLOCKABLE_LOG_STAGES_IRONALLUVIUM": "Environment Log: Iron Alluvium",
    "UNLOCKABLE_LOG_STAGES_IRONALLUVIUM2": "Environment Log: Iron Auroras",
