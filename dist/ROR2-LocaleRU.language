    "PORTAL_TRIAL_PREVIEW": "<style=cWorldEvent>An Anima Orb appears..</style>",
    "PORTAL_TRIAL_SPAWN": "<style=cWorldEvent>An Anima Portal appears..</style>",
    "PORTAL_TRIAL_EXIT_CONTEXT": "Exit the Winnowing",
