    "QUEST_COMPULSION_KILLEPICMONSTERS_SUBTITLE": "Последователь Н'куханы",
    "QUEST_COMPULSION_KILLTARGET": "Убить особых целей: {0:N0}. ({1:N0}/{0:N0})",
    "QUEST_COMPULSION_LEMURIANPOLYMORPH": "Выжить как {0}. {1:N0} с",
    "QUEST_COMPULSION_NOHITRUN": "Убить врагов, не получив ни одного удара: {0:N0}. ({1:N0}/{0:N0})",
    "QUEST_COMPULSION_SCRAPORPRINTITEMS": "Переработать предметов: {0:N0}. ({1:N0}/{0:N0})",
