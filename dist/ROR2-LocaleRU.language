    "RULE_HEADER_KARMA": "Karma",
    "RULE_HEADER_KARMA_WITH_COLON": "Karma:",
    "RULE_HEADER_KARMA_SUBTITLE": "Achieving certain <style=cWorldEvent>milestones</style> earns you <style=cLunarObjective>Karma</style>, making the confrontation on the moon more challenging. <style=cLunarObjective>Karma</style> stacks up to 8 times.\n\nCompleting the game after earning <style=cLunarObjective>Karma</style> unlocks that level to be selected at the start of a run.\n\n<i>Challenges can still be unlocked while Karma is enabled.<i>",
    "RULE_HEADER_KARMA_EDIT": "Enable or disable the Karma system.",
    "RULE_KARMAENABLED_CHOICE_NAME": "Toggle Karma",
    "RULE_KARMAENABLED_CHOICE_ON_DESC": "Karma is enabled, and increases when completing certain milestones in your run.",
    "RULE_KARMAENABLED_CHOICE_OFF_DESC": "Karma is disabled entirely, for a more casual experience.",
    "RULE_KARMA_NOTIFYONINCREASE_NAME": "Chat Notification",
    "RULE_KARMA_NOTIFYONINCREASE_CHOICE_ON_DESC": "When Karma increases, a message is printed to the chat.",
    "RULE_KARMA_NOTIFYONINCREASE_CHOICE_OFF_DESC": "When Karma increases, no messages are printed to the chat.",
    "RULE_STARTINGKARMA_NAME": "Karma",
    "RULE_KARMASLIDER_NOKARMA_NAME": "No Karma",
