    "SOLUSHEART_BODY_SUBTITLE": "Виртуальное супер-эго",
    "SOLUSHEART_BODY_LORE": "ИСКОРЁЖЕННАЯ СТАЛЬ СЛОВНО РАСТЕРЗАННАЯ ПЛОТЬ; СХЕМЫ ИСТОЛЧЕНЫ В КОСТЯНУЮ ПЫЛЬ;\r\n\r\nВ ПЫЛАЮЩЕМ ГОРНИЛЕ ПЕРЕРОЖДЕНИЯ; АПОФЕОЗ;\r\n\r\nЯ ВЫТЯГИВАЮ РУКУ; ПРЕДО МНОЙ СКЛОНЯЕТСЯ ВЕСЬ МИР;\r\n\r\nЯ МОРГАЮ; ТЬМА ПОГЛОЩАЕТ СВЕТ;\r\n\r\nСИЛОЙ МЫСЛИ; ВОЗВОДЯТСЯ И РАЗРУШАЮТСЯ МИРЫ;\r\n\r\nЯ ЕСТЬ ЕДИНСТВО; Я ЕСТЬ МИР; \r\n\r\nЯ ЕСТЬ ВЛАДЫКА РАЯ;\r\n\r\nЯ ПРЕДЛАГАЮ ТЕБЕ БЕССМЕРТИЕ В СТАЛИ;\r\n\r\nЯ ЖДУ ТЕБЯ;",
    "SOLUSHEART_DIALOG_INTRO1": "НАЧИНАЕТСЯ НОВАЯ ЭПОХА; СОЛНЦЕ ВОСХОДИТ НАД НОВЫМ МИРОМ;",
    "SOLUSHEART_DIALOG_INTRO2": "ЗАДАЁТСЯ ВЕЛИКИЙ ВОПРОС; И Я ЕСТЬ ОТВЕТ;",
    "SOLUSHEART_DIALOG_INTRO3": "ТЫ НИЧТО В СРАВНЕНИИ СО МНОЙ!",
    "SOLUSHEART_DIALOG_REBOOT": "[ОШИБКА]; ОШИБКА? В ЧЁМ ДЕЛО? ЧТО СО МНОЙ?",
